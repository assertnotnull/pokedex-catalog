# redis | vercel-kv
CACHE_BACKEND=redis

# Local Redis started with Docker Compose
REDIS_URL=redis://localhost:6379

# Vercel KV Redis protocol URL (rediss://...). Used only when CACHE_BACKEND=vercel-kv.
KV_URL=

